# Variables de Docker Compose para el entorno de desarrollo.
# Copiar a .env antes de levantar el entorno: cp .env.example .env
# La configuración propia de Laravel vive en backend/.env (E1.03).

# Puerto del host donde Nginx expone la aplicación (frontend y API bajo el mismo host, ADR-009).
WEB_PORT=8080

# Puerto del host para conectarse a PostgreSQL con un cliente externo.
DB_PORT=5432

# Credenciales de la base de desarrollo. No usar estos valores fuera del entorno local.
DB_DATABASE=wms
DB_USERNAME=wms
DB_PASSWORD=wms
