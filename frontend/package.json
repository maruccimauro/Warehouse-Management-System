    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "react-hook-form": "~7.92.0",
    "react-i18next": "~18.0.3",
    "react-router": "~8.5.2",
    "zod": "~4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@tailwindcss/vite": "~4.3.5",
    "@testing-library/dom": "~10.4.2",
