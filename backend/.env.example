APP_NAME="Warehouse Management System"
APP_ENV=local
# Lo genera el entrypoint del contenedor app al primer arranque (php artisan key:generate).
APP_KEY=
APP_DEBUG=true
# Frontend y API se sirven bajo el mismo host a través de Nginx (ADR-009).
APP_URL=http://localhost:8080

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Datos de desarrollo (config/wms.php). El entrypoint migra y siembra en cada arranque;
# los seeders son idempotentes y se niegan a correr fuera de local y testing.
WMS_DEV_ADMIN_EMAIL=admin@wms.test
WMS_DEV_ADMIN_PASSWORD=admin-dev-1
WMS_DEMO_USERS=10

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# En Docker Compose estas variables las inyecta el entorno desde el .env de la raíz
# y tienen prioridad sobre las de este archivo.
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=wms
DB_USERNAME=wms
DB_PASSWORD=wms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# La cookie de sesión no es accesible desde JavaScript y solo viaja en peticiones del mismo sitio.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false

# Sanctum en modo SPA (ADR-009): hosts cuyas peticiones se autentican por cookie de sesión.
SANCTUM_STATEFUL_DOMAINS=localhost:8080
# Orígenes externos con CORS habilitado. Vacío: frontend y API comparten host.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sin Redis hasta que haya una necesidad concreta (ADR-011): colas y caché en PostgreSQL.
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@wms.local"
MAIL_FROM_NAME="${APP_NAME}"
